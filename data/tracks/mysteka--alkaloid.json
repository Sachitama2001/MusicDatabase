      "theoryAnnotations": [
        {
          "id": "tritone-sub-eb7",
          "technique": "トライトーン代理（subV）",
          "matchType": "partial",
          "confidence": "medium",
          "location": "17〜19小節",
          "note": "Eb7(9,#11) は D minor の A7 とルートがトライトーン離れ、ガイドトーンのトライトーンを共有するため、A7 の代理ドミナントとして読める可能性がある。ただし解決先は Am7/D（D ベースの sus sonority）で、通常の Dm への解決とは異なるため部分一致とする。",
          "theoryRefs": [
            "HARM-003"
          ],
          "sources": [
            {
              "recordId": "HARM-003",
              "libraryFile": "harmony-techniques.json",
              "title": "SoundQuest — トライトーン代理",
              "author": "plugmon",
              "url": "https://soundquest.jp/quest/chord/chord-mv4/tritone-substitution/",
              "evidenceType": "human-authored-theory-to-review",
              "sourceConfidence": "high"
            }
          ],
          "sourceNote": "ChordTube印刷PDF（17〜32小節）",
          "caveat": "♭II7 という位置だけで機械的に subV と断定せず、A7とのガイドトーン共有とDベースへの解決を根拠にした暫定分析。"
        },
        {
          "id": "hybrid-am7-d",
          "technique": "ハイブリッドコード／テンションベース",
          "matchType": "direct",
          "confidence": "high",
          "location": "19・27・31小節",
          "note": "Am7/D は Am7 の上部構造に、Am7 の基本三和音外の D ベースを組み合わせたハイブリッドな響き。D9sus 的な浮遊感を作る。",
          "theoryRefs": [
            "HARM-013"
          ],
