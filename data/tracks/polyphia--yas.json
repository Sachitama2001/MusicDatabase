  "schemaVersion": "1.0",
  "id": "polyphia--yas",
  "title": "Yas",
  "artist": "Polyphia",
  "versionType": "original",
  "releaseYear": 2018,
  "bpm": 144,
  "key": "F# minor",
  "timeSignature": "4/4",
  "genres": ["math-rock", "progressive-rock", "instrumental"],
  "overallFeelings": ["スタイリッシュ", "切ない", "ハーフテンポの重み"],
  "notes": "初期サンプルエントリ。ドロップでのハーフテンポ切替と、不安定な導入から切ない響きへ着地するハーモニーの流れを記録。",
  "sections": [
    {
      "id": "sec-01-drop",
      "label": "drop",
      "displayName": "Drop",
      "order": 1,
      "feelings": ["不安定からの着地", "切ない", "ハーフテンポの重み"],
      "feelingSummary": "polyphia-yasのドロップセクションは、入り直前の不安定な響きを着地しながら、その次への切なくて泣ける響きへと繋げており、リズムセクションはBPMそのままにハーフテンポに変化して、ノリを変えている。",
      "rhythm": {
        "feel": "half-time",
        "grooveDescription": "曲全体のBPM144を保ったままスネアを3拍目に置くハーフテンポへ移行し、体感を一気に重く広げる。",
        "drumNotes": "キックは1拍目と2拍裏のシンコペーションを軸にし、スネアを3拍目に深く落としてノリを切り替える。ハイハットは細かい16分と休符でタイトさを残す。",
        "bassNotes": "コード着地時はルートを長めに保ち、小節末でオクターブや経過音を入れて次の切ないコードへ繋ぐ。",
        "tags": ["half-time", "tempo-feel-shift", "trap-influenced"]
      },
      "melody": {
        "scaleOrMode": "F# Natural Minor",
        "contour": "着地音の直後に高音域へ跳躍し、テンション音である9thや11thを経由して切なく下降する。",
        "hookDescription": "コードの変わり目で非和声音を一瞬挟んでからコードトーンへ解決させることで泣けるニュアンスを作る。",
        "register": "mid-high",
        "tags": ["emotional-leap", "tension-resolution"]
      },
      "harmony": {
        "chordProgression": ["C#7alt", "Dmaj9", "C#m7", "Bm9"],
        "romanNumerals": ["V7alt", "bVImaj9", "v7", "iv9"],
        "cadenceOrMotion": "入り直前のドミナント系テンションの不安定な響きをbVImaj9へ偽終止的に着地させ、そこからv7とiv9へ下降することで切なくて泣ける余韻へ繋げる。",
        "voicingNotes": "メジャーセブンスに9thを重ねた透明感のあるボイシングと、マイナーナインスの陰影を対比させる。",
        "tags": ["deceptive-resolution", "maj9", "minor-descent"]
      },
      "instruments": ["guitar", "bass", "drum", "piano"],
      "rating": 5,
      "tags": ["drop", "half-time", "emotional", "deceptive-cadence"],
